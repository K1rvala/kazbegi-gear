rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {

      // A signed-in user may create their own profile document once, at signup.
      // Only the designated admin email is allowed to create itself with role "admin" —
      // everyone else is forced to role "user", even if the client tries to send otherwise.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.consentAccepted == true
                    && (
                         request.resource.data.role == 'user'
                         || (request.resource.data.role == 'admin'
                             && request.auth.token.email == 'kkirvalidzee@gmail.com')
                       );

      // A user can always read their own profile.
      allow read: if request.auth != null && request.auth.uid == userId;

      // A user can update their own profile, but can never change their own role.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      // Admins (identified by their own profile's role field) can read every profile.
      allow read: if request.auth != null &&
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow delete: if false;
    }

    match /orders/{orderId} {

      // A signed-in user may create an order tagged with their own uid.
      allow create: if request.auth != null
                    && request.resource.data.customerUid == request.auth.uid;

      // A user can read their own orders; admins can read every order.
      allow read: if request.auth != null && (
                    resource.data.customerUid == request.auth.uid
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                  );

      allow update, delete: if false;
    }

    match /stock/{stockId} {

      // Stock levels are shown on the public catalog, so anyone can read them.
      allow read: if true;

      // Only admins can create a stock entry or delete one.
      allow create, delete: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Admins can adjust stock freely. Any other signed-in user may only
      // decrement quantity by up to 10 units (matches the cart's per-line
      // qty cap) and never below zero or touch any other field — this is
      // what lets reserving gear reduce the count without giving regular
      // users a way to overwrite or inflate stock.
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt'])
          && request.resource.data.quantity is int
          && request.resource.data.quantity < resource.data.quantity
          && request.resource.data.quantity >= resource.data.quantity - 10
          && request.resource.data.quantity >= 0
        )
      );
    }
  }
}
